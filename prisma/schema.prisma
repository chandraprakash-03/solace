datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String?
  preferredMode String         @default("listener") // 'listener', 'reflective', or 'advice'
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  journals      JournalEntry[]
  memories      Memory[]
  emotionLogs   EmotionLog[]
}

model Conversation {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  summary     String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  messages    Message[]
  emotionLogs EmotionLog[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // 'user' or 'assistant'
  content        String       @db.Text
  emotion        String?      // detected mood e.g. Anxious, Sad, Grateful, Tired, Angry, Calm, Happy
  intensity      Float?       // scale of 1.0 to 5.0
  createdAt      DateTime     @default(now())
}

model Memory {
  id        String                     @id @default(uuid())
  userId    String
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String                     @db.Text // summarized emotional memory
  category  String                     // category e.g. burnout, triggers, burnout-cycle, etc.
  embedding Unsupported("vector(768)")?
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
}

model EmotionLog {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mood           String        // e.g. Anxious, Sad, Grateful, Tired, Angry, Calm, Happy
  intensity      Float         // 1.0 to 5.0
  notes          String?       @db.Text
  loggedAt       DateTime      @default(now())
}

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  mood      String?  // overall self-reported/detected mood for the journal
  aiInsight String?  @db.Text // empathetic reflection generated by Gemma/Gemini
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
